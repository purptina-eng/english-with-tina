/* style.css - beige pastel, minimal, modern */
:root{
  --bg:#fbf7f4;
  --card:#fffaf6;
  --accent:#d9c9bc;
  --muted:#7b6b60;
  --accent-2:#e6dfd8;
  --glass: rgba(255,255,255,0.6);
  --maxw:1000px;
  --radius:10px;
  --shadow: 0 6px 18px rgba(99,85,76,0.08);
  font-family: Inter, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  color:var(--muted);
  line-height:1.6;
}

*{box-sizing:border-box;}
body{background:var(--bg);margin:0;padding:0;font-size:16px;}
.container{max-width:var(--maxw);margin:32px auto;padding:24px;background:var(--card);border-radius:var(--radius);box-shadow:var(--shadow);}
.header{display:flex;align-items:center;gap:16px;}
.logo{height:64px;width:64px;border-radius:8px;overflow:hidden;flex:0 0 64px;}
.site-title{font-size:20px;margin:0;color:#604e43;}
.tagline{font-size:14px;color:var(--muted);margin-top:4px;}

/* nav */
nav{margin-top:18px;display:flex;gap:12px;flex-wrap:wrap;}
nav a{padding:8px 12px;border-radius:8px;text-decoration:none;color:#50423a;background:var(--accent-2);font-weight:600;}

/* page layout */
.hero{display:flex;flex-direction:column;gap:16px;padding:18px 0;border-bottom:1px solid #efe6df;}
.hero .cols{display:flex;gap:24px;flex-wrap:wrap;}
.left{flex:1;min-width:260px;}
.right{flex:1;min-width:280px;}

/* form card */
.card{background:white;padding:18px;border-radius:10px;box-shadow:0 4px 12px rgba(99,85,76,0.04);}
label{display:block;font-weight:600;margin-bottom:6px;font-size:14px;color:#533f36;}
input[type="text"], input[type="email"], textarea, select{
  width:100%;padding:10px;border:1px solid #efe6df;border-radius:8px;background:transparent;
  font-size:14px;color:var(--muted);
}
textarea{min-height:110px;resize:vertical;}
.form-row{margin-bottom:12px;}
.btn{display:inline-block;padding:10px 16px;border-radius:10px;background:var(--accent);color:#4a3a31;border:none;font-weight:700;cursor:pointer;text-decoration:none;}

/* utility */
.small{font-size:13px;color:#826a5c;}
.footer{margin-top:22px;padding-top:16px;border-top:1px solid #efe6df;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;}

/* courses / about styling */
.course{display:flex;gap:16px;align-items:flex-start;margin-bottom:14px;}
.course img{width:120px;height:80px;object-fit:cover;border-radius:8px;}
.meta{flex:1;}

/* responsive */
@media (max-width:800px){
  .hero .cols{flex-direction:column;}
  nav{justify-content:center;}
}
